module countdown_timer (
    input logic clk,       // 50 MHz clock
    input logic rst,       // reset
    input logic start,     // botón para iniciar cuenta regresiva
    output logic [6:0] seg, // salida para 7 segmentos (activo bajo)
    output logic done      // se activa cuando llega a 0
);

    typedef enum logic [1:0] {
        IDLE,
        COUNTING,
        FINISHED
    } state_t;

    state_t state, next_state;

    logic [3:0] count;
    logic [25:0] tick_counter;  // 26 bits para contar 1 segundo a 50 MHz
    logic tick;

    // Estado de la FSM
    always_ff @(posedge clk or posedge rst) begin
        if (rst)
            state <= IDLE;
        else
            state <= next_state;
    end

    // Lógica de transición
    always_comb begin
        next_state = state;
        case (state)
            IDLE: if (start) next_state = COUNTING;
            COUNTING: if (count == 0 && tick) next_state = FINISHED;
            FINISHED: if (start) next_state = COUNTING;
        endcase
    end

    // Contador y señal de tick (1Hz)
    always_ff @(posedge clk or posedge rst) begin
        if (rst || state != COUNTING)
            tick_counter <= 0;
        else if (tick_counter == 50_000_000 - 1)
            tick_counter <= 0;
        else
            tick_counter <= tick_counter + 1;
    end
    assign tick = (tick_counter == 50_000_000 - 1);

    // Lógica de conteo regresivo
    always_ff @(posedge clk or posedge rst) begin
        if (rst)
            count <= 9;
        else if (state == IDLE)
            count <= 9;
        else if (state == COUNTING && tick && count > 0)
            count <= count - 1;
    end

    // Indica fin del conteo
    assign done = (state == FINISHED);

    // Decodificador 7 segmentos (activo bajo)
    always_comb begin
        case (count)
            4'd0: seg = 7'b1000000;
            4'd1: seg = 7'b1111001;
            4'd2: seg = 7'b0100100;
            4'd3: seg = 7'b0110000;
            4'd4: seg = 7'b0011001;
            4'd5: seg = 7'b0010010;
            4'd6: seg = 7'b0000010;
            4'd7: seg = 7'b1111000;
            4'd8: seg = 7'b0000000;
            4'd9: seg = 7'b0010000;
            default: seg = 7'b1111111;
        endcase
    end

endmodule
