module connect4_tb;
    logic clk = 0;
    logic rst;
    logic [2:0] column_select;
    logic play;
    logic player;
    logic win;
    logic [5:0][6:0] board;

    connect4 uut (
        .clk(clk),
        .rst(rst),
        .column_select(column_select),
        .play(play),
        .player(player),
        .win(win),
        .board(board)
    );

    // Generar reloj
    always #5 clk = ~clk;

    task play_turn(input logic [2:0] col, input logic p);
        @(posedge clk);
        player = p;
        column_select = col;
        play = 1;
        @(posedge clk);
        play = 0;
        @(posedge clk);
    endtask

    initial begin
        rst = 1; play = 0; player = 0; column_select = 0;
        #10;
        rst = 0;

        // Simulación: Jugador 1 y 2 juegan alternadamente en columna 0
        play_turn(0, 0); // Jugador 1
        play_turn(1, 1); // Jugador 2
        play_turn(0, 0); // Jugador 1
        play_turn(1, 1); // Jugador 2
        play_turn(0, 0); // Jugador 1
        play_turn(1, 1); // Jugador 2
        play_turn(0, 0); // Jugador 1 → debería ganar en columna 0 (4 en línea vertical)

        if (win)
            $display("¡Victoria detectada correctamente!");
        else
            $display("ERROR: No se detectó victoria.");

        $finish;
    end
endmodule
